# ─────────────────────────────────────────────────────────────────────────────
# MESH-TECH-MD — Environment Configuration
# Copy this file to .env and fill in your values before starting the bot.
# NEVER commit your .env file to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────
# Your WhatsApp number with country code, no + or spaces (e.g. 254746844168)
OWNER_NUMBER=254746844168

# ── Identity ──────────────────────────────────────────────────────────────────
OWNER_NAME=MESH
BOT_NAME=MESH TECH MD

# ── Bot Behaviour ─────────────────────────────────────────────────────────────
# Command prefix (e.g. . or ! or /)
BOT_PREFIX=.

# 'public'  — anyone can use commands
# 'private' — only the owner (and sudos) can use commands
WORK_TYPE=public

# ── Regional ──────────────────────────────────────────────────────────────────
TIMEZONE=Africa/Nairobi

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── Logging ───────────────────────────────────────────────────────────────────
# 'silent' is recommended for production; use 'info' or 'debug' to troubleshoot
LOG_LEVEL=silent

# ── Session ───────────────────────────────────────────────────────────────────
# Leave blank to pair via the web pairing page on first boot.
# Paste your SESSION_ID here to skip re-pairing after a redeploy.
# SESSION_ID=MESH-TECH-MD:~<base64-string>
# Directory for isolated per-customer Baileys sessions. On Railway, mount
# a persistent volume at this path before accepting paying customers.
# MULTI_USER_AUTH_DIR=auth_sessions
# Maximum concurrently running customer bot instances per deployment.
# MAX_BOT_INSTANCES=25

# ── Optional Features ─────────────────────────────────────────────────────────
# Your official WhatsApp group invite link (used by .join command)
# OFFICIAL_GROUP_INVITE=https://chat.whatsapp.com/XXXXXXXXXXXXXX

# Heroku API key — only needed for .update / .updatenow commands
# HEROKU_API_KEY=
# HEROKU_APP_NAME=

# PostgreSQL connection string — auto-set by Heroku Postgres add-on
# DATABASE_URL=
